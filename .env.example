# Railway > servicio n8n > Variables > Raw Editor.
# Sustituir la clave antes de desplegar. Este archivo no se carga solo.
# Las referencias ${{...}} las resuelve Railway, no Docker --env-file.
PORT=5678
N8N_PORT=5678
N8N_PROTOCOL=https
N8N_HOST=${{RAILWAY_PUBLIC_DOMAIN}}
N8N_EDITOR_BASE_URL=https://${{RAILWAY_PUBLIC_DOMAIN}}
N8N_WEBHOOK_URL=https://${{RAILWAY_PUBLIC_DOMAIN}}/
N8N_PROXY_HOPS=1
# Railway monta el volumen como root; permite escribir en /home/node/.n8n.
# Esta variable hace que el contenedor se ejecute como root en Railway.
RAILWAY_RUN_UID=0
N8N_ENCRYPTION_KEY=REEMPLAZAR_POR_UNA_CLAVE_ALEATORIA_FIJA
GENERIC_TIMEZONE=America/Mexico_City
TZ=America/Mexico_City

# Opcional: PostgreSQL. Crear primero el servicio con nombre Postgres.
# Configurarlo desde el primer despliegue si se va a utilizar.
# DB_TYPE=postgresdb
# DB_POSTGRESDB_HOST=${{Postgres.PGHOST}}
# DB_POSTGRESDB_PORT=${{Postgres.PGPORT}}
# DB_POSTGRESDB_DATABASE=${{Postgres.PGDATABASE}}
# DB_POSTGRESDB_USER=${{Postgres.PGUSER}}
# DB_POSTGRESDB_PASSWORD=${{Postgres.PGPASSWORD}}
