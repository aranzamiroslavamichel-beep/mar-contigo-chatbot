PORT=4000
# Generar una clave distinta a la de n8n: sk- seguido de 32 bytes aleatorios.
LITELLM_MASTER_KEY=sk-REEMPLAZAR_POR_UNA_CLAVE_ALEATORIA
# Generar otra clave y conservarla: cifra las credenciales guardadas en la BD.
LITELLM_SALT_KEY=REEMPLAZAR_POR_OTRA_CLAVE_ALEATORIA
# Supabase: Connect -> Session pooler, puerto 5432. Sustituir la contrasena.
# Una contrasena hexadecimal evita tener que codificar caracteres en la URL.
DATABASE_URL=postgresql://postgres.PROJECT_REF:CONTRASENA@HOST.pooler.supabase.com:5432/postgres?sslmode=require&connection_limit=5
STORE_MODEL_IN_DB=True
UI_USERNAME=admin
UI_PASSWORD=REEMPLAZAR_POR_UNA_CONTRASENA_ALEATORIA
# Clave de AI Studio del proyecto actual. No es la clave JSON de Sheets.
GEMINI_API_KEY=REEMPLAZAR_POR_LA_CLAVE_DE_GEMINI
# En Railway, descomentar y usar el dominio publico real, sin barra final.
# PROXY_BASE_URL=https://TU-DOMINIO-LITELLM.up.railway.app
