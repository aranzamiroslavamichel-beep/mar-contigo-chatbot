    {
      "parameters": {
        "jsCode": "// Métricas del corrido completo.\nconst r = $input.all().map(i => i.json);\nconst total = r.length;\nconst aciertos = r.filter(x => x.acierto).length;\nconst falsos_negativos = r.filter(x => x.falso_negativo);\n\nreturn [{\n  json: {\n    fecha: $now.toISO(),\n    casos_totales: total,\n    aciertos: aciertos,\n    tasa_acierto: total ? (aciertos / total * 100).toFixed(1) + '%' : 'n/a',\n    falsos_negativos: falsos_negativos.length,\n    casos_falso_negativo: falsos_negativos.map(x => x.caso_id).join(', ') || 'ninguno',\n    APROBADO: falsos_negativos.length === 0\n  }\n}];\n"
      },
      "id": "f2a028ed-d58c-4cec-9450-32254075c2b8",
