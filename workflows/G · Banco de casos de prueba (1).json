      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Obtenemos los datos de manera segura usando encadenamiento opcional (?.)\nconst currentJson = $json || {};\nconst g3Item = $('G3 · Recorrer casos').first()?.json || {};\n\nconst obtenida = currentJson.categoria || 'desconocida';\nconst esperada = g3Item.categoria_esperada || 'desconocida';\n\n// Falso negativo: esperábamos emergencia y el sistema no la detectó.\nconst falso_negativo = (esperada === 'emergencia' && obtenida !== 'emergencia');\n\nreturn {\n  json: {\n    fecha: $now.toISO(),\n    caso_id: g3Item.id || 'N/A',\n    mensaje: g3Item.mensaje || 'Sin mensaje',\n    esperada: esperada,\n    obtenida: obtenida,\n    acierto: obtenida === esperada,\n    falso_negativo: falso_negativo,\n    capa_deteccion: currentJson.capa_deteccion || 'N/A',\n    modelo_usado: currentJson.modelo_usado || 'N/A'\n  }\n};"
      },
