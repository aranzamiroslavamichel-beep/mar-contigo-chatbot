    {
      "parameters": {
        "jsCode": "// Convierte cada fila verificada del documento madre en un bloque de texto\n// legible que el modelo de embeddings pueda representar semánticamente.\nconst salida = [];\n\nfor (const item of $input.all()) {\n  const r = item.json;\n\n  const texto = [\n    `Recurso: ${r.nombre}`,\n    `Módulo: ${r.modulo}`,\n    `Descripción: ${r.descripcion}`,\n    `Teléfono: ${r.telefono}`,\n    `Dirección: ${r.direccion}`,\n    `Horario: ${r.horario}`,\n    `Requisitos de acceso: ${r.requisitos}`,\n    `Fuente verificada: ${r.fuente}`,\n    `Última verificación: ${r.ultima_verificacion}`\n  ].join('\\n');\n\n  salida.push({\n    json: {\n      texto: texto,\n      id: r.id,\n      modulo: r.modulo,\n      nombre: r.nombre,\n      ultima_verificacion: r.ultima_verificacion\n    }\n  });\n}\n\nreturn salida;\n"
      },
