    {
      "parameters": {
        "jsCode": "// Formatea los recursos verificados del módulo elegido.\n// Cero IA: todo el texto sale de las columnas del documento madre.\n// Ningún dato se completa, se infiere ni se reformatea.\n\nconst filas = $input.all();\n\nif (filas.length === 0) {\n  return [{ json: { texto_recursos:\n    'No hay recursos verificados disponibles para esa opción en este momento.\\n\\nSi necesitas ayuda urgente: 911' } }];\n}\n\nconst bloques = filas.map(item => {\n  const r = item.json;\n  const lineas = [`<b>${r.nombre}</b>`];\n  if (r.telefono)   lineas.push(`📞 ${r.telefono}`);\n  if (r.direccion)  lineas.push(`📍 ${r.direccion}`);\n  if (r.horario)    lineas.push(`🕐 ${r.horario}`);\n  if (r.requisitos) lineas.push(`ℹ️ ${r.requisitos}`);\n  return lineas.join('\\n');\n});\n\nreturn [{ json: { texto_recursos: bloques.join('\\n\\n') } }];\n"
      },
