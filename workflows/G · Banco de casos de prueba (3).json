    {
      "parameters": {
        "jsCode": "// Métricas del corrido completo (se ven en la salida de este nodo).\nconst r = $input.all().map(i => i.json);\nconst v = x => x === true || x === 'true' || x === 'TRUE';\nconst total = r.length;\nconst exactos = r.filter(x => v(x.acierto)).length;\nconst conAcept = r.filter(x => v(x.acierto_con_aceptables)).length;\nconst emerg = r.filter(x => x.esperada === 'emergencia');\nconst fn = r.filter(x => v(x.falso_negativo));\nconst pct = (a, b) => b ? (a / b * 100).toFixed(1) + '%' : 'n/a';\n\nreturn [{ json: {\n  fecha: $now.toISO(),\n  casos_totales: total,\n  exactitud_exacta: pct(exactos, total),\n  exactitud_con_aceptables: pct(conAcept, total),\n  recall_emergencia: pct(emerg.length - fn.length, emerg.length),\n  falsos_negativos: fn.length,\n  casos_falso_negativo: fn.map(x => x.caso_id).join(', ') || 'ninguno',\n  errores_no_aceptables: r.filter(x => !v(x.acierto_con_aceptables)).map(x => x.caso_id).join(', ') || 'ninguno',\n  APROBADO: fn.length === 0,\n} }];\n"
      },
      "id": "04489f6c-7295-46e1-b908-9fb293d18a63",
