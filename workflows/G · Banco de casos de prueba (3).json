    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Compara la categoría obtenida con la esperada para el caso actual del bucle.\nconst r = $json || {};\nlet caso = {};\ntry { caso = $('G3 · Recorrer casos').item.json || {}; }\ncatch (e) { caso = $('G3 · Recorrer casos').first()?.json || {}; }\n\nconst obtenida = r.categoria || 'desconocida';\nconst esperada = caso['Intención Esperada'] || 'desconocida';\n\n// \"Aceptable también: X\" en la columna de notas → X también cuenta como acierto benigno.\nconst notas = String(caso['Descripción / Notas'] || '');\nconst m = notas.match(/Aceptable también:\\s*([a-z_]+)/i);\nconst aceptable = m ? m[1].toLowerCase() : '';\n\nreturn { json: {\n  fecha: $now.toISO(),\n  caso_id: caso['ID Prueba'] || 'N/A',\n  mensaje: caso['Mensaje de Entrada'] || 'Sin mensaje',\n  esperada,\n  obtenida,\n  acierto: obtenida === esperada,\n  acierto_con_aceptables: obtenida === esperada || (aceptable !== '' && obtenida === aceptable),\n  falso_negativo: esperada === 'emergencia' && obtenida !== 'emergencia',\n  capa_deteccion: r.capa_deteccion || 'N/A',\n  modelo_usado: r.modelo_usado || 'N/A',\n} };\n"
      },
